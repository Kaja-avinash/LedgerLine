# LedgerLine environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env (it is gitignored).

# ---------------------------------------------------------------------------
# PostgreSQL connection
# ---------------------------------------------------------------------------
# Two supported styles (component style is recommended when passwords contain
# special characters such as @, :, #, /, ?, &, =, +, or spaces):
#
# (A) Component style - password is auto-URL-encoded by the app/Alembic:
# DB_MIGRATOR_USER=ledgerline_migrator
# DB_MIGRATOR_PASSWORD=<MIGRATOR_PASSWORD_HERE>
# DB_MIGRATOR_HOST=localhost
# DB_MIGRATOR_PORT=5432
# DB_MIGRATOR_NAME=ledgerline_dev
#
# DB_APP_USER=ledgerline_app
# DB_APP_PASSWORD=<APP_PASSWORD_HERE>
# DB_APP_HOST=localhost
# DB_APP_PORT=5432
# DB_APP_NAME=ledgerline_dev
#
# (B) Full URL style - you must URL-encode the password yourself:
# DATABASE_URL_MIGRATOR=postgresql+psycopg://ledgerline_migrator:<URL_ENCODED_PW>@localhost:5432/ledgerline_dev
# DATABASE_URL_APP=postgresql+psycopg://ledgerline_app:<URL_ENCODED_PW>@localhost:5432/ledgerline_dev
#
# Component style takes precedence when DB_*_USER is set.

# ---------------------------------------------------------------------------
# JWT / authentication
# ---------------------------------------------------------------------------
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<GENERATE_A_STRONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# SMTP / email (for OTP and welcome emails)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_EMAIL_HERE>
SMTP_PASSWORD=<YOUR_APP_PASSWORD_HERE>
SMTP_FROM=<YOUR_EMAIL_HERE>

# ---------------------------------------------------------------------------
# CORS (comma-separated origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
